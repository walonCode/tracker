<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1 widget: the Next task label and a Start button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/focus_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/focus_widget_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/focus_widget_text"
        android:textSize="15sp" />

    <Button
        android:id="@+id/focus_widget_start"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="72dp"
        android:text="@string/focus_widget_start"
        android:textAllCaps="false" />
</LinearLayout>
