<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup, Android 12 and above: the SQLite database only. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="SQLite/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="SQLite/" />
    </device-transfer>
</data-extraction-rules>
