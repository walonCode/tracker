{
  "expo": {
    "name": "tracker",
    "slug": "tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.walonfoundation.tracker",
      "icon": "./assets/images/icon.png",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.walonfoundation.tracker"]
      }
    },
    "android": {
      "package": "com.walonfoundation.tracker",
      "adaptiveIcon": {
        "backgroundColor": "#208AEF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ContributionGraph",
              "label": "Contribution Graph",
              "description": "Recent-days activity grid for one tracker or all trackers combined.",
              "minWidth": "250dp",
              "minHeight": "150dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "previewImage": "./assets/images/widget-preview-contribution-graph.png"
            },
            {
              "name": "ProjectTime",
              "label": "Project Time",
              "description": "Total time logged on your projects, this range.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "previewImage": "./assets/images/widget-preview-project-time.png"
            },
            {
              "name": "Prayer",
              "label": "Prayer",
              "description": "Today's fard/sunnah status for each of the five daily prayers.",
              "minWidth": "220dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "previewImage": "./assets/images/widget-preview-prayer.png"
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["armeabi-v7a", "arm64-v8a", "x86", "x86_64"]
          }
        }
      ],
      [
        "@bacons/apple-targets",
        {
          "root": "./ios-widgets"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f4e00854-43c6-4274-8215-b5993e794b6a"
      }
    }
  }
}
